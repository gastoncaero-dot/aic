rules_version = "2";

// Reglas de seguridad de Firestore para Prode Mundial 2026.
// Pegar este archivo completo en Firebase Console > Firestore Database > Reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ---------------------------------------------------------
    // Perfiles de usuario (users/{uid}: username, is_admin, created_at)
    // ---------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.is_admin == false;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.is_admin == resource.data.is_admin;
    }

    // ---------------------------------------------------------
    // Equipos y partidos: lectura pública, edición solo admin.
    // matches/{id} incluye kickoff_at y lock_at (kickoff - 5min).
    // ---------------------------------------------------------
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Configuración general (appSettings/main): cierre de pronósticos
    // especiales y resultados finales del torneo.
    // ---------------------------------------------------------
    match /appSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Pronósticos de partidos. Doc id = "{uid}_{matchId}".
    // Lectura: cualquier usuario logueado (simplificación frente al
    // esquema original con Postgres, que solo mostraba pronósticos
    // ajenos una vez arrancado el partido). Escritura: solo el dueño,
    // antes de que cierre el partido (lock_at).
    // ---------------------------------------------------------
    match /predictions/{predId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && predId == request.auth.uid + "_" + string(request.resource.data.match_id)
        && request.resource.data.home_score is int
        && request.resource.data.home_score >= 0 && request.resource.data.home_score <= 99
        && request.resource.data.away_score is int
        && request.resource.data.away_score >= 0 && request.resource.data.away_score <= 99
        && request.time < timestamp.value(
             get(/databases/$(database)/documents/matches/$(string(request.resource.data.match_id))).data.lock_at
           );
    }

    // ---------------------------------------------------------
    // Pronósticos especiales (campeón, subcampeón, goleador). Doc id = uid.
    // ---------------------------------------------------------
    match /specialPredictions/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && uid == request.auth.uid
        && request.resource.data.user_id == uid
        && request.time < timestamp.value(
             get(/databases/$(database)/documents/appSettings/main).data.special_predictions_lock_at
           );
    }

    // ---------------------------------------------------------
    // Ligas privadas. member_ids es un array de uids.
    // Lectura abierta a usuarios logueados (necesario para buscar una
    // liga por código de invitación al sumarse). Crear: el dueño se
    // suma a sí mismo como único miembro inicial. Actualizar: solo se
    // permite agregar miembros (sumarse con un código), no sacarlos.
    // ---------------------------------------------------------
    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.owner_id == request.auth.uid
        && request.resource.data.member_ids == [request.auth.uid];
      allow update: if isSignedIn()
        && request.auth.uid in request.resource.data.member_ids
        && request.resource.data.member_ids.hasAll(resource.data.member_ids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["member_ids"]);
    }
  }
}
